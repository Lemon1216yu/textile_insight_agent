# Actual .env is generated by scripts/configure.py; never commit secrets.
TEXTILE_ENV=dev
TEXTILE_DB_HOST=127.0.0.1
TEXTILE_DB_PORT=3318
TEXTILE_DB_NAME=textile_insight
TEXTILE_DB_USER=textile_reader
TEXTILE_APP_USER=textile_app
TEXTILE_DB_PASSWORD=GENERATED_BY_CONFIGURE
TEXTILE_MYSQL_ROOT_PASSWORD=GENERATED_BY_CONFIGURE
TEXTILE_MINIO_PASSWORD=GENERATED_BY_CONFIGURE
TEXTILE_SESSION_SECRET=GENERATED_BY_CONFIGURE
MILVUS_URI=http://127.0.0.1:19530
TEXTILE_MILVUS_COLLECTION=textile_schema_metrics_v2
TEXTILE_REDIS_URL=redis://127.0.0.1:6379/0
TEXTILE_DAILY_TOKEN_LIMIT=1000000
# Generation model chain (DashScope, OpenAI-compatible). The first entry is preferred;
# when its free quota is exhausted (403 FreeTierOnly) the next model is used automatically
# and the exhausted one is cooled down in Redis for TEXTILE_LLM_COOLDOWN_SECONDS.
TEXTILE_LLM_MODEL=qwen3.8-flash
TEXTILE_LLM_MODELS=qwen3.8-flash,qwen3.8-max-0902,qwen3.8-max,deepseek-v4.1-flash,kimi-k3,qwen-turbo
TEXTILE_LLM_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
TEXTILE_LLM_COOLDOWN_SECONDS=300
# Leave empty to use DASHSCOPE_API_KEY for chat calls.
TEXTILE_LLM_API_KEY=
TEXTILE_EMBED_MODEL=text-embedding-v3
TEXTILE_EMBED_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
# Set DASHSCOPE_API_KEY in your environment or local .env (used for chat + embedding).
# DEEPSEEK_API_KEY is no longer read by this project.
# A8 SQL 资源治理：语句超时（毫秒，仅只读 SELECT，由 MySQL max_execution_time 强制）
# 与慢查询阈值（毫秒，超过则写结构化日志并在 /api/health 的 sql_governance 计数）。
TEXTILE_QUERY_TIMEOUT_MS=8000
TEXTILE_SLOW_QUERY_MS=200
